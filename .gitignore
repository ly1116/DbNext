# 依赖
node_modules/

# 构建产物
dist/
dist-electron/
release/

# 日志与缓存
*.log
npm-debug.log*
.DS_Store

# 构建/诊断临时产物（tsc、build、restart、vite 临时配置文件等）
tsc-*.txt
build-*.txt
mtimes.txt
restart-log.txt
run2-utf8.txt
vite.config.ts.timestamp-*.mjs
*.log

# 本地环境变量
.env
.env.local

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.err

# Windows 保留设备名残留文件（nul/con/aux 等无法经 Win32 删除，仅作忽略以免污染 git status）
/nul
/con
/aux

# WorkBuddy 项目内存（不含源码，不外传到仓库）
.workbuddy/
